+export type RecallStateKey = "not-reviewed" | "needs-work" | "developing" | "holding" | "strong";
+export type RecallState = { key: RecallStateKey; label: string; score: number | null; attempts: number };
+
+export const REVIEW_GRADE_LABELS = {
+  again: "Missed",
+  hard: "Partial",
+  good: "Recalled",
+  easy: "Secure",
+} as const;
+
+export function recallScore(card: CardWithStats) {
+  const { again_count, hard_count, good_count, easy_count } = card.stats;
+  const attempts = again_count + hard_count + good_count + easy_count;
+  if (!attempts) return null;
+  return (hard_count * 0.35 + good_count * 0.75 + easy_count) / attempts;
+}
+
+export function recallState(card: CardWithStats, directions?: DirectionTemplates): RecallState {
+  const attempts = card.stats.again_count + card.stats.hard_count + card.stats.good_count + card.stats.easy_count;
+  if (!attempts) return { key: "not-reviewed", label: "Not reviewed", score: null, attempts: 0 };
+  const score = recallScore(card) ?? 0;
+  if (isKeepMissing(card) || score < 0.45) return { key: "needs-work", label: "Needs work", score, attempts };
+  if (attempts < 3 || score < 0.68 || (directions ? isWeakProduction(card, directions) : false)) return { key: "developing", label: "Developing", score, attempts };
+  if (attempts >= 5 && score >= 0.88) return { key: "strong", label: "Strong", score, attempts };
+  return { key: "holding", label: "Holding", score, attempts };
+}
+
+export function recallStateRank(card: CardWithStats, directions?: DirectionTemplates) {
+  const state = recallState(card, directions);
+  return { "not-reviewed": 0, "needs-work": 1, developing: 2, holding: 3, strong: 4 }[state.key];
+}
