+.knowledge-entry-backdrop{position:fixed;inset:0;z-index:1700;display:grid;place-items:center;padding:28px;background:rgba(34,30,26,.24);backdrop-filter:blur(7px)}
+.knowledge-entry-modal{width:min(1080px,96vw);height:min(860px,94vh);display:flex;flex-direction:column;overflow:hidden;border:1px solid #ddd5ca;border-radius:16px;background:#fbfaf7;box-shadow:0 34px 90px rgba(35,30,25,.2);color:#302b27}
+.knowledge-entry-topbar{display:flex;align-items:center;justify-content:space-between;min-height:48px;padding:0 16px;border-bottom:1px solid #ebe5dc;background:rgba(255,255,255,.72)}
