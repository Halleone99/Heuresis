+++ b/heuresis_work/Heuresis-main/src/components/KnowledgeEntryModal.tsx
@@ -0,0 +1,289 @@
+import { ArrowLeft, BookOpen, GitFork, X } from "lucide-react";
+import { useEffect, useMemo, useState } from "react";
+import {
+  fieldByRole,
+  fieldText,
+  getCard,
+  listCardsByIds,
+  setCardRetention,
+  type CardWithStats,
+  type Collection,
+  type PackWithType,
+} from "../lib/heuresis";
+import { getLearningCounts, LEARNING_ACTION_LABELS, listReviewHistory, type LearningCounts, type ReviewHistoryItem } from "../lib/learning";
+import { listRelatedCatalogue, relationLabel, type RelatedCatalogueRow } from "../lib/related";
+import ConnectionsPanel from "./ConnectionsPanel";
+import "./knowledge-entry.css";
+
+type Props = {
+  cardId: string;
+  packs: PackWithType[];
+  collections: Collection[];
+  onClose: () => void;
+  onOpenPack?: (pack: PackWithType) => void;
+};
+
+type WorkspaceBlock = {
+  id: string;
+  dim: string;
+  type: string;
+  text: string;
+  reading: string;
+  translation: string;
+  caption: string;
+};
+
+const WORKSPACE_BLOCKS_KEY = "_workspace_blocks";
+const DIM_LABEL: Record<string, string> = {
+  components: "Parts",
+  neighbours: "Related",
+  examples: "Examples",
+  structure: "Structure",
+  origin: "Origin",
+  facts: "Facts",
+  notes: "Notes",
+};
+
+function parseBlocks(card: CardWithStats | null): WorkspaceBlock[] {
+  const raw = card?.data[WORKSPACE_BLOCKS_KEY];
+  if (!Array.isArray(raw)) return [];
+  return raw.flatMap((entry, index) => {
+    try {
+      const value = JSON.parse(entry) as Record<string, unknown>;
+      const text = typeof value.text === "string" ? value.text : "";
+      const source = typeof value.source === "string" ? value.source : "";
+      const reading = typeof value.reading === "string" ? value.reading : "";
+      const translation = typeof value.translation === "string" ? value.translation : "";
+      const caption = typeof value.caption === "string" ? value.caption : "";
+      return [{
+        id: typeof value.id === "string" ? value.id : `${card?.id ?? "card"}-${index}`,
+        dim: typeof value.dim === "string" ? value.dim : "notes",
+        type: typeof value.type === "string" ? value.type : "text",
+        text: text || source,
+        reading,
+        translation,
+        caption,
+      }];
+    } catch {
+      return [{ id: `${card?.id ?? "card"}-${index}`, dim: "notes", type: "text", text: entry, reading: "", translation: "", caption: "" }];
+    }
+  });
+}
+
+function relativeDate(value: string | null) {
+  if (!value) return "not reviewed yet";
+  const time = Date.parse(value);
+  if (!Number.isFinite(time)) return value;
+  const days = Math.max(0, Math.floor((Date.now() - time) / 86400000));
+  if (days === 0) return "today";
+  if (days === 1) return "yesterday";
+  if (days < 14) return `${days} days ago`;
+  if (days < 60) return `${Math.round(days / 7)} weeks ago`;
+  return new Date(time).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" });
+}
+
+function relationSemantic(row: RelatedCatalogueRow, currentId: string) {
+  const outgoing = row.source_card_id === currentId;
+  if (row.relation_type === "part_of") return outgoing ? "part of" : "contains";
+  if (row.relation_type === "depends_on") return outgoing ? "depends on" : "supports";
+  if (row.relation_type === "example_of") return outgoing ? "example of" : "has example";
+  if (row.relation_type === "contrasts_with" || row.relation_type === "antonym") return "contrasts with";
+  if (row.relation_type === "synonym") return "similar to";
+  return relationLabel(row.relation_type).toLocaleLowerCase();
+}
+
+function emptyCounts(): LearningCounts {
+  return { handwrite: 0, type: 0, sentence: 0, rephrase: 0, example: 0, say: 0, hear: 0 };
+}
+
+export default function KnowledgeEntryModal({ cardId, packs, collections, onClose, onOpenPack }: Props) {
+  const [currentId, setCurrentId] = useState(cardId);
+  const [trail, setTrail] = useState<string[]>([cardId]);
+  const [card, setCard] = useState<CardWithStats | null>(null);
+  const [relationRows, setRelationRows] = useState<RelatedCatalogueRow[]>([]);
+  const [relatedCards, setRelatedCards] = useState<Record<string, CardWithStats>>({});
+  const [counts, setCounts] = useState<LearningCounts>(emptyCounts());
+  const [history, setHistory] = useState<ReviewHistoryItem[]>([]);
+  const [loading, setLoading] = useState(true);
+  const [error, setError] = useState("");
+  const [retentionBusy, setRetentionBusy] = useState(false);
+  const [connectionsOpen, setConnectionsOpen] = useState(false);
+
+  const packMap = useMemo(() => new Map(packs.map((item) => [item.id, item])), [packs]);
+  const collectionMap = useMemo(() => new Map(collections.map((item) => [item.id, item])), [collections]);
+  const pack = card ? packMap.get(card.pack_id) ?? null : null;
+  const collection = pack ? collectionMap.get(pack.collection_id) ?? null : null;
+  const termField = fieldByRole(pack?.cardType, "term") ?? pack?.cardType?.field_schema[0] ?? null;
+  const readingField = fieldByRole(pack?.cardType, "reading");
+  const meaningField = fieldByRole(pack?.cardType, "meaning") ?? pack?.cardType?.field_schema[1] ?? null;
+  const term = card ? fieldText(card.data, termField?.key) || "Untitled" : "";
+  const reading = card ? fieldText(card.data, readingField?.key) : "";
+  const meaning = card ? fieldText(card.data, meaningField?.key) : "";
+  const blocks = useMemo(() => parseBlocks(card), [card]);
+
+  useEffect(() => {
+    setCurrentId(cardId);
+    setTrail([cardId]);
+  }, [cardId]);
+
+  useEffect(() => {
+    let alive = true;
+    setLoading(true);
+    setError("");
+    void (async () => {
+      try {
+        const [nextCard, rows, countMap, reviewHistory] = await Promise.all([
+          getCard(currentId),
+          listRelatedCatalogue(),
+          getLearningCounts([currentId]).catch(() => ({} as Record<string, LearningCounts>)),
+          listReviewHistory(currentId, 8).catch(() => []),
+        ]);
+        if (!nextCard) throw new Error("This knowledge entry no longer exists.");
+        const connectedRows = rows.filter((row) => row.source_card_id === currentId || row.target_card_id === currentId);
+        const otherIds = Array.from(new Set(connectedRows.map((row) => row.source_card_id === currentId ? row.target_card_id : row.source_card_id)));
+        const others = otherIds.length ? await listCardsByIds(otherIds) : [];
+        if (!alive) return;
+        setCard(nextCard);
+        setRelationRows(connectedRows);
+        setRelatedCards(Object.fromEntries(others.map((item) => [item.id, item])));
+        setCounts(countMap[currentId] ?? emptyCounts());
+        setHistory(reviewHistory);
+      } catch (loadError) {
+        if (alive) setError(loadError instanceof Error ? loadError.message : "Could not open this entry.");
+      } finally {
+        if (alive) setLoading(false);
+      }
+    })();
+    return () => { alive = false; };
+  }, [currentId]);
+
+  function openEntry(id: string) {
+    if (id === currentId) return;
+    const existing = trail.indexOf(id);
+    setTrail(existing >= 0 ? trail.slice(0, existing + 1) : [...trail, id]);
+    setCurrentId(id);
+    setConnectionsOpen(false);
+  }
+
+  function otherCopy(row: RelatedCatalogueRow) {
+    const otherId = row.source_card_id === currentId ? row.target_card_id : row.source_card_id;
+    const other = relatedCards[otherId];
+    const otherPack = other ? packMap.get(other.pack_id) ?? null : null;
+    if (!other || !otherPack) {
+      return row.source_card_id === currentId
+        ? { id: otherId, term: row.term || "Untitled", meaning: row.meaning, pack: null as PackWithType | null }
+        : { id: otherId, term: row.source_term || "Untitled", meaning: row.source_meaning, pack: null as PackWithType | null };
+    }
+    const otherTerm = fieldByRole(otherPack.cardType, "term") ?? otherPack.cardType?.field_schema[0] ?? null;
+    const otherMeaning = fieldByRole(otherPack.cardType, "meaning") ?? otherPack.cardType?.field_schema[1] ?? null;
+    return { id: otherId, term: fieldText(other.data, otherTerm?.key) || "Untitled", meaning: fieldText(other.data, otherMeaning?.key), pack: otherPack };
+  }
+
+  async function toggleRetention() {
+    if (!card || card.role !== "main" || retentionBusy) return;
+    const previous = card.retention;
+    const next = previous === "learning" ? "reference" : "learning";
+    setCard({ ...card, retention: next });
+    setRetentionBusy(true);
+    try {
+      await setCardRetention(card.id, next);
+    } catch (saveError) {
+      setCard({ ...card, retention: previous });
+      setError(saveError instanceof Error ? saveError.message : "Could not change review state.");
+    } finally {
+      setRetentionBusy(false);
+    }
+  }
+
+  const extraFields = (pack?.cardType?.field_schema ?? []).filter((field) => ![termField?.key, readingField?.key, meaningField?.key].includes(field.key));
+  const learningMethods = (Object.keys(counts) as Array<keyof LearningCounts>).filter((key) => counts[key] > 0);
+
+  return <div className="knowledge-entry-backdrop" role="presentation" onMouseDown={(event) => { if (event.currentTarget === event.target) onClose(); }}>
+    <section className="knowledge-entry-modal" role="dialog" aria-modal="true" aria-label="Knowledge entry">
+      <header className="knowledge-entry-topbar">
+        <div className="knowledge-entry-trail">
+          {trail.length > 1 ? <button onClick={() => { const next = trail.slice(0, -1); setTrail(next); setCurrentId(next[next.length - 1]); }}><ArrowLeft size={14} /> Back</button> : null}
+          <span>{collection?.title ?? "Heuresis"}{pack ? ` · ${pack.title}` : ""}</span>
+        </div>
+        <button className="knowledge-entry-close" onClick={onClose} aria-label="Close entry"><X size={18} /></button>
+      </header>
+
+      {loading ? <div className="knowledge-entry-state">Opening entry…</div> : null}
+      {!loading && error && !card ? <div className="knowledge-entry-state error">{error}</div> : null}
+      {!loading && card && pack ? <div className="knowledge-entry-scroll">
+        <section className="knowledge-entry-hero">
+          <div>
+            <span className={`knowledge-entry-retention ${card.retention}`}>{card.role === "related" ? "Connected reference" : card.retention === "learning" ? "In review" : "Reference"}</span>
+            <h1>{term}</h1>
+            {reading ? <em>{reading}</em> : null}
+            {meaning ? <p>{meaning}</p> : null}
+          </div>
+          <div className="knowledge-entry-actions">
+            {card.role === "main" ? <button disabled={retentionBusy} onClick={() => void toggleRetention()}>{card.retention === "learning" ? "Keep as reference" : "Add to review"}</button> : null}
+            <button onClick={() => setConnectionsOpen(true)}><GitFork size={14} /> Map</button>
+            {onOpenPack ? <button onClick={() => { onClose(); onOpenPack(pack); }}><BookOpen size={14} /> Topic</button> : null}
+          </div>
+        </section>
+
+        {error ? <p className="knowledge-entry-inline-error">{error}</p> : null}
+
+        <div className="knowledge-entry-grid">
+          <main>
+            {extraFields.some((field) => fieldText(card.data, field.key)) ? <section className="knowledge-entry-section">
+              <h2>Card fields</h2>
+              <div className="knowledge-entry-fields">{extraFields.map((field) => {
+                const value = fieldText(card.data, field.key);
+                return value ? <article key={field.key}><small>{field.label}</small><p>{value}</p></article> : null;
+              })}</div>
+            </section> : null}
+
+            {blocks.length ? <section className="knowledge-entry-section">
+              <h2>Knowledge</h2>
+              <div className="knowledge-entry-blocks">{blocks.map((block) => <article key={block.id}>
+                <small>{DIM_LABEL[block.dim] ?? block.dim}{block.type === "example" ? " · example" : ""}</small>
+                {block.text ? <p>{block.text}</p> : null}
+                {block.reading ? <em>{block.reading}</em> : null}
+                {block.translation ? <p className="translation">{block.translation}</p> : null}
+                {block.type === "image" ? <p className="translation">{block.caption || "Image reference"}</p> : null}
+              </article>)}</div>
+            </section> : null}
+
+            {card.note ? <section className="knowledge-entry-section"><h2>My note</h2><p className="knowledge-entry-note">{card.note}</p></section> : null}
+
+            <section className="knowledge-entry-section">
+              <div className="knowledge-entry-section-head"><h2>Connections</h2><span>{relationRows.length}</span></div>
+              {relationRows.length ? <div className="knowledge-entry-links">{relationRows.map((row) => {
+                const other = otherCopy(row);
+                return <button key={row.relation_id} onClick={() => openEntry(other.id)}>
+                  <span><small>{relationSemantic(row, currentId)}</small><strong>{other.term}</strong>{other.meaning ? <p>{other.meaning}</p> : null}</span>
+                  <em>{other.pack?.title ?? "Connected entry"} →</em>
+                </button>;
+              })}</div> : <p className="knowledge-entry-muted">No connections yet.</p>}
+            </section>
+          </main>
+
+          <aside>
+            <section className="knowledge-entry-review">
+              <div className="knowledge-entry-section-head"><h2>Review</h2><span>{card.stats.study_count}</span></div>
+              {card.retention === "reference" ? <p className="knowledge-entry-muted">Reference only. It creates no review debt.</p> : <>
+                <div className="knowledge-entry-review-stats">
+                  <article><strong>{card.stats.study_count}</strong><small>reviews</small></article>
+                  <article><strong>{card.stats.good_count + card.stats.easy_count}</strong><small>good / easy</small></article>
+                  <article><strong>{card.stats.again_count}</strong><small>again</small></article>
+                </div>
+                <p className="knowledge-entry-last">Last reviewed {relativeDate(card.stats.last_encountered_at)}</p>
+              </>}
+              {learningMethods.length ? <div className="knowledge-entry-methods"><small>HOW YOU REVIEWED</small>{learningMethods.map((action) => <span key={action}>{LEARNING_ACTION_LABELS[action]} <b>{counts[action]}</b></span>)}</div> : null}
+              {history.length ? <div className="knowledge-entry-history"><small>RECENT REVIEW SESSIONS</small>{history.map((item) => <article key={item.sessionId}><div><strong>{relativeDate(item.reviewedAt)}</strong>{item.grade ? <span className={`grade ${item.grade}`}>{item.grade}</span> : null}</div><p>{item.methods.length ? item.methods.map((action) => LEARNING_ACTION_LABELS[action]).join(" · ") : "Flashcard review"}</p></article>)}</div> : null}
+            </section>
+
+            {card.tags.length ? <section className="knowledge-entry-side-section"><h2>Tags</h2><div className="knowledge-entry-tags">{card.tags.map((tag) => <span key={tag.id}>{tag.name}</span>)}</div></section> : null}
+            <section className="knowledge-entry-side-section"><h2>Record</h2><p>Added {new Date(card.created_at).toLocaleDateString("en-GB", { day: "numeric", month: "short", year: "numeric" })}</p><p>Updated {relativeDate(card.updated_at)}</p></section>
+          </aside>
+        </div>
+      </div> : null}
+
+      {connectionsOpen && card && pack ? <ConnectionsPanel pack={pack} card={card} onClose={() => setConnectionsOpen(false)} onOpenEntry={(id) => { setConnectionsOpen(false); openEntry(id); }} /> : null}
+    </section>
+  </div>;
+}
