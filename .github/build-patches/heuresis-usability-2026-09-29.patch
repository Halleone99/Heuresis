+
+export type ReviewHistoryItem = {
+  sessionId: string;
+  reviewedAt: string;
+  grade: "again" | "hard" | "good" | "easy" | null;
+  methods: LearningAction[];
+};
+
+const REVIEW_EVENT_ACTION: Record<string, LearningAction | undefined> = {
+  exercise_handwrite: "handwrite",
+  exercise_type: "type",
+  exercise_sentence: "sentence",
+  exercise_rephrase: "rephrase",
+  exercise_example: "example",
+  exercise_say: "say",
+  exercise_hear: "hear",
+};
+
+export async function listReviewHistory(cardId: string, limit = 8): Promise<ReviewHistoryItem[]> {
+  if (!cardId) return [];
+  const { data, error } = await db()
+    .from("heuresis_card_events")
+    .select("session_id,event_type,created_at")
+    .eq("card_id", cardId)
+    .in("event_type", [
+      "again", "hard", "good", "easy",
+      "exercise_handwrite", "exercise_type", "exercise_sentence",
+      "exercise_rephrase", "exercise_example", "exercise_say", "exercise_hear",
+    ])
+    .order("created_at", { ascending: false })
+    .limit(Math.max(24, Math.min(160, limit * 12)));
+  if (error) throw error;
+
+  const grouped = new Map<string, ReviewHistoryItem>();
+  for (const row of (data ?? []) as Array<{ session_id?: unknown; event_type?: unknown; created_at?: unknown }>) {
+    if (typeof row.session_id !== "string" || typeof row.event_type !== "string" || typeof row.created_at !== "string") continue;
+    const current = grouped.get(row.session_id) ?? { sessionId: row.session_id, reviewedAt: row.created_at, grade: null, methods: [] };
+    if (row.created_at > current.reviewedAt) current.reviewedAt = row.created_at;
+    if (row.event_type === "again" || row.event_type === "hard" || row.event_type === "good" || row.event_type === "easy") current.grade = row.event_type;
+    const action = REVIEW_EVENT_ACTION[row.event_type];
+    if (action && !current.methods.includes(action)) current.methods.push(action);
+    grouped.set(row.session_id, current);
+  }
+
+  return Array.from(grouped.values())
+    .filter((item) => item.grade || item.methods.length)
+    .sort((a, b) => b.reviewedAt.localeCompare(a.reviewedAt))
+    .slice(0, Math.max(1, limit));
+}
